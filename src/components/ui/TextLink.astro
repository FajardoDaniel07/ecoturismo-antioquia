---
/** Enlace de texto (S1): cafetal con subrayado de 1 px; en hover, tinta y subrayado de 2 px. */
interface Props {
  href: string;
  class?: string;
}

const { href, class: extra = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center text-primary underline decoration-1 underline-offset-4 transition-colors duration-(--duration-fast) hover:text-ink hover:decoration-2 active:text-ink',
    extra,
  ]}
>
  <slot />
</a>
