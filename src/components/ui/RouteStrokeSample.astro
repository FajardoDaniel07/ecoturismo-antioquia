---
/**
 * Muestra de trazo (S9.1): un segmento de 48 px con el patrón de la línea de la ruta en el mapa.
 * Solo se ve cuando el mapa está activo: nace oculta (clase `hidden`) y la isla del mapa la muestra (`data-map-only`).
 */
import type { RouteStyle } from '../../lib/routes/style';

interface Props {
  style: RouteStyle;
}

const { style } = Astro.props;
const STROKE: Record<RouteStyle['zone'], string> = {
  warm: 'stroke-zone-warm',
  temperate: 'stroke-zone-temperate',
  cold: 'stroke-zone-cold',
  paramo: 'stroke-zone-paramo',
};
const round = style.pattern === 'dots';
---

<svg
  data-map-only
  aria-hidden="true"
  focusable="false"
  width="48"
  height="10"
  viewBox="0 0 48 10"
  class="hidden shrink-0"
>
  <line
    x1="1"
    y1="5"
    x2="47"
    y2="5"
    stroke-width={style.weight}
    stroke-dasharray={style.dashArray ?? undefined}
    stroke-linecap={round ? 'round' : 'butt'}
    class={STROKE[style.zone]}
  ></line>
  {style.variant === 'double' && (
    <line x1="1" y1="5" x2="47" y2="5" stroke-width="2" class="stroke-bg"></line>
  )}
</svg>
