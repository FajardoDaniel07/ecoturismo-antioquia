---
/**
 * Mapa de rutas (S9, CA-67, CA-80; mapa simple): título, línea, el mapa (solo con JavaScript,
 * cargado al acercarse la sección) y la lista de rutas, siempre visible. Si no hay rutas
 * publicadas, la página no incluye la sección.
 */
import RouteMap from '../islands/RouteMap.astro';
import RouteList from './RouteList.astro';
import type { Ruta } from '../../lib/content/validate';
import { SECTION_IDS } from '../../lib/nav';
import { orderRoutes } from '../../lib/routes/style';

interface Props {
  rutas: Ruta[];
}

const { rutas } = Astro.props;
const ordered = orderRoutes(rutas);
---

<section id={SECTION_IDS.mapa} aria-labelledby="mapa-titulo" class="pb-16 lg:pb-24">
  <div class="mx-auto w-full max-w-page px-5 md:px-8 lg:px-12">
    <h2
      id="mapa-titulo"
      tabindex="-1"
      class="font-display text-2xl font-bold text-ink focus:outline-none md:text-3xl"
    >
      Mapa de rutas
    </h2>
    <p class="mt-2 max-w-prose text-ink-muted">
      Cada ruta pertenece a un destino. Aquí ves por dónde pasa y cuánto sube.
    </p>
    <div class="route-map-layout mt-8">
      <RouteMap dataUrl="/data/rutas.json" />
      <RouteList rutas={ordered} />
    </div>
  </div>
</section>
