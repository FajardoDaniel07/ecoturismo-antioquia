---
/**
 * Contenido del panel "Ruta seleccionada" (S9.4), uno por ruta, generado en el build y guardado en
 * un <template>: la isla del mapa solo lo clona. Sin JavaScript no se ve ni existe en el árbol.
 */
import ElevationProfile from '../ui/ElevationProfile.astro';
import Ficha from '../ui/Ficha.astro';
import TextLink from '../ui/TextLink.astro';
import { SWATCH } from '../ui/zone-swatch';
import { buildFicha } from '../../lib/ficha/build';
import { formatElevationRange } from '../../lib/format/units';
import type { Ruta } from '../../lib/content/validate';
import { buildElevationProfile } from '../../lib/routes/elevation-profile';
import type { RouteStyle } from '../../lib/routes/style';

interface Props {
  rutas: (Ruta & { key: string; style: RouteStyle })[];
}

const { rutas } = Astro.props;
---

{rutas.map((ruta) => {
  const profile = buildElevationProfile(ruta.geometry.coordinates);
  return (
    <template data-route-panel={ruta.id}>
      <div class="flex items-center gap-3">
        <span
          aria-hidden="true"
          class:list={[
            'inline-flex size-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold text-white',
            SWATCH[ruta.zone],
          ]}
        >
          {ruta.key}
        </span>
        <h4 class="m-0 font-display text-lg font-bold text-ink">
          <span class="sr-only">Ruta {ruta.key}, </span>
          {ruta.properties.name}
        </h4>
      </div>
      <p class="mt-2 text-ink-muted">
        {formatElevationRange(ruta.properties.elevation.minM, ruta.properties.elevation.maxM)}
      </p>
      {profile && <ElevationProfile model={profile} zone={ruta.zone} />}
      <Ficha rows={buildFicha(ruta, 'full')} variant="summary" class="mt-3" />
      <p class="mt-3">
        <TextLink href={ruta.destino.href}>Ir a {ruta.destino.name}</TextLink>
      </p>
    </template>
  );
})}
