---
/**
 * Detalle de un destino (S7, CA-23, CA-31 a CA-36, CA-38, CA-40 a CA-42). Bloques: volver, título,
 * altitud, imagen o lámina, ficha, descripción (el cuerpo Markdown, por `slot`), fotos, rutas y
 * contacto. Qué se muestra según las fotos lo decide `detailLayout()` (S6.4).
 */
import AltitudePlate from '../ui/AltitudePlate.astro';
import ContourDefs from '../ui/ContourDefs.astro';
import Ficha from '../ui/Ficha.astro';
import Photo from '../ui/Photo.astro';
import TextLink from '../ui/TextLink.astro';
import ZoneRail from '../ui/ZoneRail.astro';
import Contacto from './Contacto.astro';
import PhotoGrid from './PhotoGrid.astro';
import { zoneName, zoneRange } from '../../lib/altitude/zones';
import type { SiteKind, Territory } from '../../lib/content/schemas';
import type { Destino, PublishedOperator, Ruta } from '../../lib/content/validate';
import { buildFicha } from '../../lib/ficha/build';
import { formatAltitude, formatElevationRange } from '../../lib/format/units';
import { SECTION_IDS } from '../../lib/nav';
import { detailLayout, mainPhoto } from '../../lib/photos/policy';

interface Props {
  destino: Destino;
  rutas: Ruta[];
  territory: Territory;
  operator: PublishedOperator;
  siteKind: SiteKind;
}

const { destino, rutas, territory, operator, siteKind } = Astro.props;

const layout = detailLayout(destino.photos);
const main = mainPhoto(destino.photos);
const usesPlate = layout !== 'beside-ficha' && layout !== 'main-and-grid';
const rows = buildFicha(destino, 'full');
const range = zoneRange(destino.zone, territory);
const beside = layout === 'beside-ficha';
const showPhotos =
  layout === 'main-and-grid' || layout === 'plate-and-small' || layout === 'plate-and-grid';
const MAIN_SIZES = '(min-width: 1024px) 640px, calc(100vw - 56px)';
const SMALL_SIZES = '(min-width: 1024px) 440px, (min-width: 768px) 480px, calc(100vw - 56px)';
---

<article class="mx-auto w-full max-w-page px-5 pt-6 pb-16 md:px-8 md:pt-8 lg:px-12 lg:pb-24">
  {usesPlate && <ContourDefs zones={[destino.zone]} />}

  <p class="mb-6">
    <TextLink href={`/#${SECTION_IDS.destinos}`}>Volver a los destinos</TextLink>
  </p>

  <ZoneRail zones={[destino.zone]} range={range} headingLevel="none">
    <h1 class="font-display text-2xl font-bold text-ink md:text-3xl lg:text-3xl">{destino.name}</h1>
    <p class="mt-2 text-lg text-ink">
      {formatAltitude(destino.altitude.meters, 'long')}, piso {zoneName(destino.zone)}
    </p>

    <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-8 lg:grid-cols-10">
      <div class:list={[beside ? 'lg:col-span-5' : 'lg:col-span-7']}>
        {beside ? (
          <div class="max-w-[30rem] space-y-6">
            {destino.photos.map((photo) => (
              <Photo photo={photo} slot="small" sizes={SMALL_SIZES} loading="lazy" credit />
            ))}
          </div>
        ) : main ? (
          <Photo photo={main} slot="large" sizes={MAIN_SIZES} loading="eager" credit />
        ) : (
          <AltitudePlate zone={destino.zone} altitudeM={destino.altitude.meters} ratio="3:2" />
        )}
      </div>

      <div class:list={[beside ? 'lg:col-span-5' : 'lg:col-span-3']}>
        <h2 class="mb-3 font-display text-xl font-bold text-ink">Datos de la salida</h2>
        <Ficha rows={rows} variant="full" />
      </div>

      <div class:list={['richtext', 'lg:col-span-7 lg:row-start-2']}>
        <slot />
      </div>
    </div>
  </ZoneRail>

  <div class="mt-12 space-y-12 lg:grid lg:grid-cols-12 lg:gap-x-6 lg:space-y-0">
    <div class="space-y-12 lg:col-span-10 lg:col-start-3">
      {showPhotos && (
        <section aria-labelledby="fotos-titulo">
          <h2 id="fotos-titulo" class="font-display text-xl font-bold text-ink md:text-2xl">
            Fotos de {destino.name}
          </h2>
          <div class="mt-4">
            {layout === 'plate-and-small' ? (
              <ul class="m-0 grid max-w-[30rem] list-none gap-6 p-0 md:max-w-none md:grid-cols-2">
                {destino.photos.map((photo) => (
                  <li>
                    <Photo photo={photo} slot="small" sizes={SMALL_SIZES} loading="lazy" credit />
                  </li>
                ))}
              </ul>
            ) : (
              <PhotoGrid photos={destino.photos} showDestino={false} />
            )}
          </div>
        </section>
      )}

      {rutas.length > 0 && (
        <section aria-labelledby="rutas-titulo">
          <h2 id="rutas-titulo" class="font-display text-xl font-bold text-ink md:text-2xl">
            Rutas de {destino.name}
          </h2>
          <ul class="m-0 mt-4 grid list-none gap-8 p-0 lg:grid-cols-2">
            {rutas.map((ruta) => (
              <li>
                <h3 class="font-display text-lg font-bold text-ink">{ruta.properties.name}</h3>
                <p class="mt-1 text-ink-muted">
                  {formatElevationRange(
                    ruta.properties.elevation.minM,
                    ruta.properties.elevation.maxM,
                  )}
                </p>
                <Ficha rows={buildFicha(ruta, 'full')} variant="full" class="mt-3" />
              </li>
            ))}
          </ul>
        </section>
      )}

      <Contacto operator={operator} siteKind={siteKind} variant="cta" destinoName={destino.name} />
    </div>
  </div>
</article>
