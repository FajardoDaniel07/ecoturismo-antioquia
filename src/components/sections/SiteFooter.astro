---
/**
 * Pie de página (S2, CA-50, CA-98, CA-119, CA-121). Fondo tinta. El identificador oficial solo
 * aparece si el operador lo entregó y no es de relleno: `operator` ya viene filtrado por la puerta
 * de publicación, así que sin identificadores no hay línea ni hueco.
 */
import type { LegalDoc, PublishedOperator } from '../../lib/content/validate';
import { SECTION_IDS } from '../../lib/nav';
import { SITE_NAME } from '../../lib/seo/meta';

interface Props {
  operator: PublishedOperator;
  legal: LegalDoc[];
}

const { operator, legal } = Astro.props;

const LEGAL_LABELS: Record<LegalDoc['kind'], string> = {
  privacy: 'Política de tratamiento de datos',
  terms: 'Términos y condiciones',
  cancellation: 'Política de cancelación',
};

const links = [
  { label: 'Contacto', href: `/#${SECTION_IDS.contacto}` },
  ...legal.map((l) => ({ label: LEGAL_LABELS[l.kind], href: `/legal/${l.slug}/` })),
  { label: 'Créditos de las fotos', href: '/creditos/' },
];
---

<footer class="on-ink bg-ink text-on-ink">
  <div class="mx-auto grid w-full max-w-page grid-cols-1 gap-x-6 gap-y-8 px-5 py-12 md:grid-cols-8 md:px-8 lg:grid-cols-12 lg:px-12">
    <div class="md:col-span-3 lg:col-span-4">
      <p class="font-display text-lg font-bold">{SITE_NAME}</p>
      {operator.name !== SITE_NAME && <p class="mt-1 text-on-ink-muted">{operator.name}</p>}
      {operator.identifiers.length > 0 && (
        <ul class="mt-3 text-sm text-on-ink-muted">
          {operator.identifiers.map((i) => (
            <li>
              {i.label.charAt(0).toUpperCase() + i.label.slice(1)}: {i.value}
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-label="Información del sitio" class="md:col-span-5 lg:col-span-8">
      <ul class="grid grid-cols-1 gap-x-6 md:grid-cols-2">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-11 items-center text-on-ink underline decoration-1 underline-offset-4 transition-colors duration-(--duration-fast) hover:bg-bg hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
