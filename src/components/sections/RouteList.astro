---
/**
 * Lista de rutas (S9.1, CA-21, CA-76, CA-80): siempre visible, con o sin JavaScript. Cada ruta lleva
 * una franja de 6 px del color de su piso, su nombre, la elevación, el perfil de elevación (si tiene
 * elevación por punto), la ficha completa y el enlace a su destino. Cada elemento tiene un `id`
 * al que apunta el popup del mapa.
 */
import ElevationProfile from '../ui/ElevationProfile.astro';
import Ficha from '../ui/Ficha.astro';
import TextLink from '../ui/TextLink.astro';
import { SWATCH } from '../ui/zone-swatch';
import { buildFicha } from '../../lib/ficha/build';
import { formatElevationRange } from '../../lib/format/units';
import type { Ruta } from '../../lib/content/validate';
import { buildElevationProfile } from '../../lib/routes/elevation-profile';
import { ATTRIBUTION_HREF, ATTRIBUTION_TEXT } from '../../lib/routes/map-config';

interface Props {
  rutas: Ruta[];
}

const { rutas } = Astro.props;
---

<div>
  <h3 class="font-display text-xl font-bold text-ink">Todas las rutas</h3>
  <p class="mt-2 text-sm text-ink-muted">
    Trazados: <TextLink href={ATTRIBUTION_HREF}>{ATTRIBUTION_TEXT}</TextLink>
  </p>
  <ul class="m-0 mt-4 grid list-none gap-8 p-0">
    {rutas.map((ruta) => {
      const profile = buildElevationProfile(ruta.geometry.coordinates);
      return (
        <li class="relative scroll-mt-6 pl-4" id={`ruta-${ruta.id}`}>
          <span
            aria-hidden="true"
            class:list={['absolute inset-y-0 left-0 w-1.5', SWATCH[ruta.zone]]}
          />
          <h4 class="m-0 font-display text-lg font-bold text-ink">{ruta.properties.name}</h4>
          <p class="mt-1 text-ink-muted">
            {formatElevationRange(ruta.properties.elevation.minM, ruta.properties.elevation.maxM)}
          </p>
          {profile && <ElevationProfile model={profile} zone={ruta.zone} />}
          <Ficha rows={buildFicha(ruta, 'full')} variant="full" class="mt-3" />
          <p class="mt-3">
            <TextLink href={ruta.destino.href}>Ir a {ruta.destino.name}</TextLink>
          </p>
        </li>
      );
    })}
  </ul>
</div>
