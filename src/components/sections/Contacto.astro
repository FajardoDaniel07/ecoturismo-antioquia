---
/**
 * Contacto (S10, S14.2; CA-36, CA-81 a CA-83, CA-91, CA-131, CA-132). Dos variantes: la sección
 * del inicio (`section`, fondo superficie de lado a lado) y la llamada del detalle de destino
 * (`cta`). En modo académico cambian el título, la invitación y el mensaje, y se añade la aclaración
 * "Este contacto es de prueba" justo encima del botón. El botón es un enlace: funciona sin
 * JavaScript. El número, el horario y el correo son texto.
 */
import Button from '../ui/Button.astro';
import type { SiteKind } from '../../lib/content/schemas';
import type { PublishedOperator } from '../../lib/content/validate';
import { buildWhatsAppUrl, formatPhone, whatsAppMessage } from '../../lib/contact/whatsapp';
import { SECTION_IDS } from '../../lib/nav';

interface Props {
  operator: PublishedOperator;
  siteKind: SiteKind;
  variant: 'section' | 'cta';
  destinoName?: string;
}

const { operator, siteKind, variant, destinoName } = Astro.props;
const academic = siteKind === 'academic';
const section = variant === 'section';

const title = academic
  ? section || !destinoName
    ? 'Contacto de prueba'
    : `Escribir sobre ${destinoName}`
  : section || !destinoName
    ? 'Escríbenos para planear tu salida'
    : `¿Te interesa ${destinoName}?`;

const invitation = academic
  ? 'Puedes escribirnos para probar cómo funciona el contacto de este proyecto.'
  : 'Cuéntanos qué destino te interesa y cuántas personas van. Te respondemos por WhatsApp.';

const url = buildWhatsAppUrl(operator.whatsapp, whatsAppMessage(siteKind, destinoName));
const [emailUser, emailDomain] = operator.email.split('@');
const titleId = section ? 'contacto-titulo' : 'contacto-destino-titulo';
---

<section
  id={section ? SECTION_IDS.contacto : undefined}
  aria-labelledby={titleId}
  class:list={[section ? 'bg-surface py-12 lg:py-16' : 'rounded-md bg-surface p-4 md:p-6']}
>
  <div class:list={[section ? 'mx-auto w-full max-w-page px-5 md:px-8 lg:px-12' : '']}>
    <div class="grid grid-cols-1 gap-x-6 gap-y-6 lg:grid-cols-12">
      <div class:list={[academic ? 'lg:col-span-8' : 'lg:col-span-6']}>
        <h2
          id={titleId}
          class:list={[
            'font-display font-bold text-ink',
            section ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl',
          ]}
        >
          {title}
        </h2>
        <p class="mt-3 max-w-prose text-ink">{invitation}</p>
      </div>

      <div class="lg:col-span-6 lg:row-start-2">
        {academic && (
          <p class="mb-3 max-w-prose text-base font-semibold text-ink">
            Este contacto es de prueba: no se reservan ni se venden salidas.
          </p>
        )}
        <Button variant="primary" href={url} fullWidth class="md:w-auto">
          Escribir por WhatsApp
        </Button>
      </div>

      <div
        class:list={[
          'space-y-1 lg:col-span-5 lg:col-start-8',
          academic ? 'lg:row-start-2' : 'lg:row-span-2 lg:row-start-1',
        ]}
      >
        <p>
          WhatsApp: <span class="whitespace-nowrap">{formatPhone(operator.whatsapp)}</span>
        </p>
        <p>Horario de atención: {operator.hours}</p>
        <p>
          Si no usas WhatsApp, escríbenos a{' '}
          <a
            href={`mailto:${operator.email}`}
            class="inline-flex min-h-11 items-center text-primary underline decoration-1 underline-offset-4 hover:text-ink hover:decoration-2"
          >
            {emailUser}
            <wbr />@{emailDomain}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
