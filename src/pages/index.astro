---
/**
 * Inicio. Por ahora solo el hero (T-051); las demás secciones se añaden en T-052 y siguientes.
 */
import Hero from '../components/sections/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSite } from '../lib/content/load';
import { documentTitle } from '../lib/seo/meta';

const site = await loadSite();
---

<BaseLayout
  title={documentTitle()}
  description="Destinos de ecoturismo en Antioquia ordenados por altura, del valle al páramo."
>
  <Hero territory={site.territory} destinos={site.destinos} />
</BaseLayout>
