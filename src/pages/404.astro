---
/** Página 404 (S13, CA-37): en español, con dos enlaces. Cabecera y pie completos. */
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTION_IDS } from '../lib/nav';
import { documentTitle } from '../lib/seo/meta';
---

<BaseLayout
  title={documentTitle('Esta dirección no existe')}
  description="La dirección que buscas no existe en este sitio. Vuelve al inicio o mira los destinos."
>
  <section class="mx-auto w-full max-w-page px-5 py-16 md:px-8 lg:px-12 lg:py-24">
    <h1 class="font-display text-3xl font-bold text-ink md:text-4xl">Esta dirección no existe</h1>
    <p class="mt-4 max-w-prose text-lg text-ink">
      Puede que el enlace esté mal escrito o que la página ya no esté.
    </p>
    <div class="mt-8 flex flex-col gap-4 md:flex-row">
      <Button variant="primary" href="/">
        Ir al inicio
      </Button>
      <Button variant="secondary" href={`/#${SECTION_IDS.destinos}`}>
        Ver destinos
      </Button>
    </div>
  </section>
</BaseLayout>
