{
  "name": "ecoturismo-antioquia",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build --mode preview",
    "build:release": "astro check && astro build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "preview": "astro preview",
    "test": "vitest run tests/unit",
    "test:build": "vitest run tests/build",
    "test:e2e": "playwright test",
    "test:capturas": "playwright test -c playwright.capturas.config.ts",
    "test:lh": "node scripts/lhci.mjs",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "~1.1.0",
    "typescript-eslint": "~8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
